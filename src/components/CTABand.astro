---
import Icon from './Icon.astro';
---
<section class="bg-sun">
  <div class="wrap flex flex-col gap-8 py-16 lg:flex-row lg:items-center lg:justify-between">
    <div>
      <h2 class="text-[52px] sm:text-[72px] lg:text-[96px] leading-[.95] text-navy">Ready to beat the heat?</h2>
      <p class="mt-3 font-display text-[22px] sm:text-[30px] font-bold uppercase text-navy">Get a fixed quote in 48 hours. No pressure, no surprises.</p>
    </div>
    <div class="flex flex-col gap-3 sm:flex-row lg:flex-col lg:w-[255px]">
      <a href="/contact#quote" class="btn btn-navy"><Icon name="arrow" />Get a Free Quote</a>
      <a href="tel:1300000000" class="btn btn-ghost-navy"><Icon name="phone" />Call 1300 000 000</a>
    </div>
  </div>
</section>
