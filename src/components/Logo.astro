---
const { href = '/' } = Astro.props;
---
<a href={href} class="flex items-center gap-2.5 sm:gap-3.5 min-w-0" aria-label="Paperbark Air Co. home">
  <span class="grid size-[40px] sm:size-[46px] shrink-0 place-items-center bg-sun font-display text-[34px] font-black text-forest">P</span>
  <span class="leading-none">
    <span class="block font-display text-[22px] sm:text-[30px] font-black uppercase tracking-wide text-white">Paperbark Air Co.</span>
    <span class="mt-1 block font-display text-[10px] sm:text-[12px] font-semibold uppercase tracking-[.14em] text-sun">Air conditioning · Strathpine QLD</span>
  </span>
</a>
