---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageTitle from '../components/PageTitle.astro';
import Icon from '../components/Icon.astro';
import Tag from '../components/Tag.astro';
import SampleTag from '../components/SampleTag.astro';
import { img } from '../components/img';
import barky from '../assets/barky.svg?raw';
const stats = [['10+', 'Years on the tools'], ['3,000+', 'Systems installed'], ['4.9★', 'Customer rating'], ['48 hrs', 'Fixed quotes']];
const values = [
  ['01', 'Tell the real price', 'Fixed written quotes. If the job changes, we call you before we touch a thing.'],
  ['02', 'Turn up when we say', 'On time, in a navy polo, in a clearly marked ute. If we’re running late, you’ll hear it from us first.'],
  ['03', 'Size it properly', 'The right kW for your room, not the biggest unit on the shelf.'],
  ['04', 'Leave it cleaner', 'Drop sheets down, pipework neat, site vacuumed. You shouldn’t know we’ve been.'],
  ['05', 'Stand behind it', '5-year workmanship warranty, handled by the people who did the job.'],
];
const team = [['Jake', 'Lead installer', '12 years on the tools. Will talk your ear off about inverters.', 'pexels-5463587'], ['Mel', 'Quotes & service', 'Measures up, writes the quote and answers the phone.', 'pexels-7347538'], ['Tom', 'Repairs', 'The one who turns up at 7am in a heatwave.', 'pexels-32588555']];
const lic = [
  ['QBCC Licence', 'Queensland Building and Construction Commission licensed contractor. Lic. 0000000'],
  ['ARC Refrigerant Licence', 'Authorised to handle refrigerants under the ARC scheme. Lic. AU00000'],
  ['$20M Public Liability', 'Full public liability cover on every job, certificate available on request.'],
  ['5-Year Workmanship Warranty', 'On top of the manufacturer’s warranty, backed by us.'],
  ['Fixed Written Quotes', 'No hidden extras. The price on the quote is the price you pay.'],
];
---
<Base title="About | Paperbark Air Co." description="A small Strathpine crew keeping Brisbane’s northside cool, one honest quote at a time." active="About">
  <PageTitle photo="pexels-5866151" crumb="About" title="Local tradies, straight talk" lede="A small Strathpine crew keeping Brisbane’s northside cool, one honest quote at a time." />
  <section class="py-16 lg:py-24">
    <div class="wrap grid items-center gap-10 lg:grid-cols-[600px_1fr] lg:gap-[72px]">
      <div class="relative"><Image src={img('pexels-5463587')} alt="Technician servicing an outdoor unit" widths={[600, 1200]} sizes="(min-width:1024px) 600px, 100vw" class="h-[360px] w-full object-cover sm:h-[560px]" /><SampleTag /></div>
      <div>
        <p class="eyebrow text-forest-2">Our story</p>
        <h2 class="mt-4 text-[44px] sm:text-[64px] text-forest">Started in a ute, still run like it</h2>
        <p class="mt-6 text-[17px] sm:text-[19px] leading-relaxed text-muted">Paperbark Air Co. started with one van, one toolbox and a simple idea: tell people the real price, turn up when you said you would and leave the place cleaner than you found it.</p>
        <p class="mt-4 text-[17px] sm:text-[19px] leading-relaxed text-muted">Today we’re a small crew of licensed Strathpine tradies. We still quote every job ourselves, we still answer the phone, and we still put our name on every install.</p>
        <p class="mt-7 bg-sun px-6 py-5 font-display text-[26px] sm:text-[34px] font-black uppercase leading-none text-navy">“We’re not happy until you’re happy.”</p>
      </div>
    </div>
  </section>
  <section class="bg-navy">
    <ul class="mx-auto grid max-w-[1440px] grid-cols-2 lg:grid-cols-4">
      {stats.map(([n, l]) => (
        <li class="border-b border-r border-white/10 px-5 py-8 lg:px-9 lg:py-9">
          <p class="font-display text-[56px] sm:text-[88px] font-black uppercase leading-[.9] text-sun">{n}</p>
          <p class="mt-3 flex flex-wrap items-center gap-2 font-display text-[17px] sm:text-[20px] font-extrabold uppercase text-white">{l} <Tag dark /></p>
        </li>
      ))}
    </ul>
  </section>
  <section class="bg-cream py-16 lg:py-24">
    <div class="wrap">
      <p class="eyebrow text-forest-2">How we work</p>
      <h2 class="h2 mt-3">Five rules we don’t break</h2>
      <ol class="mt-11 border-2 border-forest">
        {values.map(([n, t, d], i) => (
          <li class={`grid items-center gap-2 px-6 py-6 lg:grid-cols-[90px_1fr_1fr] lg:gap-6 lg:px-8 ${i % 2 ? 'bg-white' : 'bg-cream'} ${i ? 'border-t border-forest/20' : ''}`}>
            <span class="font-display text-[48px] lg:text-[64px] font-black leading-none text-sun">{n}</span>
            <h3 class="text-[28px] lg:text-[34px] text-forest">{t}</h3>
            <p class="text-[16px] lg:text-[17px] leading-normal text-muted">{d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>
  <section class="py-16 lg:py-24">
    <div class="wrap">
      <div class="flex flex-wrap items-end justify-between gap-5">
        <div><p class="eyebrow text-forest-2">The person at your door</p><h2 class="h2 mt-3">Meet the crew</h2></div>
        <p class="bg-navy px-4 py-2.5 font-display text-[16px] font-extrabold uppercase text-sun">Sample team for demo purposes</p>
      </div>
      <div class="mt-11 grid items-start gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {team.map(([n, r, d, p]) => (
          <article class="border-b-[6px] border-sun bg-cream">
            <Image src={img(p)} alt="" widths={[320, 640]} sizes="(min-width:1024px) 315px, (min-width:640px) 50vw, 100vw" class="h-[300px] w-full object-cover" />
            <div class="p-5"><h3 class="text-[40px] text-forest">{n}</h3><p class="font-display text-[17px] font-extrabold uppercase tracking-wide text-forest-2">{r}</p><p class="mt-2 text-[15px] text-muted">{d}</p></div>
          </article>
        ))}
        <article class="bg-sun">
          <div class="mx-auto h-[306px] w-[240px] overflow-hidden pt-5"><div class="w-[240px]" set:html={barky} role="img" aria-label="Barky the koala" /></div>
          <div class="p-5 text-center text-navy"><h3 class="text-[40px]">Barky</h3><p class="font-display text-[17px] font-extrabold uppercase tracking-wide">Chief Cool Officer</p><p class="mt-2 text-[15px]">Supervises every install. Never misses a smoko.</p></div>
        </article>
      </div>
    </div>
  </section>
  <section class="bg-forest py-16 lg:py-24">
    <div class="wrap grid gap-10 lg:grid-cols-[480px_1fr] lg:gap-16">
      <div>
        <p class="eyebrow text-sun">Licensed &amp; insured</p>
        <h2 class="mt-4 text-[44px] sm:text-[64px] text-white">Fully licensed. Fully covered.</h2>
        <p class="mt-5 text-[17px] sm:text-[19px] leading-relaxed text-mint-text">Air conditioning work is regulated for good reason. Here’s what stands behind every Paperbark Air job.</p>
        <a href="/contact#quote" class="btn btn-sun mt-7">Get a Free Quote</a>
      </div>
      <ul class="border-2 border-white/20">
        {lic.map(([t, d], i) => (
          <li class={`flex gap-4 px-6 py-5 ${i ? 'border-t border-white/15' : ''}`}>
            <span class="mt-1 grid size-8 shrink-0 place-items-center bg-sun text-navy"><Icon name="check" size={18} /></span>
            <div><p class="flex flex-wrap items-center gap-2"><span class="font-display text-[24px] sm:text-[28px] font-black uppercase text-white">{t}</span><Tag dark /></p><p class="mt-1 text-[16px] text-[#c9d8cd]">{d}</p></div>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
